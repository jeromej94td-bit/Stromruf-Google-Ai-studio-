    <!-- 2. The Stylish Open Ring (Metallic Turquoise and Neon-Green gradient) -->
    <path
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 54,28 A 26,26 0 0 1 76,70">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="82"
                android:endY="54"
                android:startX="54"
                android:startY="26"
                android:type="linear">
                <item android:color="#00F0FF" android:offset="0.0" />
                <item android:color="#00FF87" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. The Left-Side Telephone Handset Segment -->
    <!-- Incorporates the distinct handset handles, earpiece (top) and mouthpiece (bottom) connected via the crescent -->
    <!-- Inner silver-turquoise core of the handset -->
    <path
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 48,31 A 26,26 0 0 0 46,77">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="30"
                android:endY="76"
                android:startX="46"
                android:startY="32"
                android:type="linear">
                <item android:color="#A3FBE3" android:offset="0.0" />
                <item android:color="#4BE3B5" android:offset="0.5" />
                <item android:color="#1EA880" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Earpiece Cap (at the top-left of the receiver) -->
    <path android:strokeLineJoin="round" android:strokeLineCap="round"
        android:pathData="M 41,26 L 52,32 C 53.5,32.8 54,34.8 53.2,36.3 L 51,40.5 C 50.2,42 48.2,42.5 46.7,41.7 L 36,35.5 C 34.5,34.7 34,32.7 34.8,31.2 L 37,27 C 37.8,25.5 39.8,25 41,26 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="52"
                android:endY="34"
                android:startX="38"
                android:startY="26"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#5CFFD0" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Mouthpiece Cap (at the bottom-left/center of the receiver) -->
    <path android:strokeLineJoin="round" android:strokeLineCap="round"
        android:pathData="M 48,68 L 59,74 C 60.5,74.8 61,76.8 60.2,78.3 L 58,82.5 C 57.2,84 55.2,84.5 53.7,83.7 L 43,77.5 C 41.5,76.7 41,74.7 41.8,73.2 L 44,69 C 44.8,67.5 46.8,67 48,68 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="64"
                android:endY="78"
                android:startX="48"
                android:startY="70"
                android:type="linear">
