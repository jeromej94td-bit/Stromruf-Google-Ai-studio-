        android:translateX="2"
        android:translateY="4">
        <!-- Shadow for Ring/Handset -->
        <path
            android:fillColor="#3D00140E"
            android:pathData="M 54,30 C 67.25,30 78,40.75 78,54 C 78,67.25 67.25,78 54,78 C 44,78 35.34,71.86 31.84,63.09 C 30.69,60.2 32.55,57 35.68,57 L 41.34,57 C 43.19,57 44.83,58.26 45.24,60.07 C 46.99,67.75 53.84,72.5 61.2,69.9 C 66.86,67.9 71.1,62.1 71.9,55.5 C 72.8,48.1 68.1,41.4 61,40.1 C 58,39.56 55.43,40.83 54.21,43.08 L 50.1,50.71 L 43.43,38 Z" />
        <!-- Shadow for Lightning Bolt -->
        <path
            android:fillColor="#3D00140E"
            android:pathData="M 33,75 L 51,57 L 44,57 L 70,31 L 58,31 L 79,25 L 72,46 L 65,39 L 47,57 L 54,57 Z" />
