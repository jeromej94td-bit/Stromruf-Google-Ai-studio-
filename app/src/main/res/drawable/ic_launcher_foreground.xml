    <!-- 5. Inner Laser-Sharp White Core of Lightning Bolt (Ultra brightness) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 34,73 L 47,58 L 44,58 L 67,34 L 61,34 L 74,28 L 69,41 L 64,36 L 47,54 L 51,54 Z" />

    <!-- 6. Glowing Electric Spark & Electric Arcs overlay (Right neon crescent sparkle) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M 76,42 Q 81,49 76,56"
        android:strokeWidth="1.8"
        android:strokeColor="#00FF87"
        android:strokeLineCap="round" />

    <path
        android:fillColor="#00000000"
        android:pathData="M 30,44 Q 24,51 30,58"
        android:strokeWidth="1.5"
        android:strokeColor="#00F0FF"
        android:strokeLineCap="round" />

    <!-- Sparkle star in upper-right area -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 85,30 Q 88,30 88,27 Q 88,30 91,30 Q 88,30 88,33 Q 88,30 85,30 Z" />

    <!-- Sparkle star in bottom-left area -->
    <path
        android:fillColor="#00FF87"
        android:pathData="M 21,70 Q 24,70 24,67 Q 24,70 27,70 Q 24,70 24,73 Q 24,70 21,70 Z" />

</vector>
