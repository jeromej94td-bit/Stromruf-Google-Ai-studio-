        </aapt:attr>
    </path>

    <!-- 4. Dynamic Lightning Bolt Arrow (High-Contrast Neon-Lime & White Glow) -->
    <path android:strokeLineJoin="round" android:strokeLineCap="round"
        android:pathData="M 31,76 L 49,58 L 42,58 L 68,32 L 57,32 L 77,25 L 70,45 L 63,38 L 46,56 L 53,56 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="78"
                android:endY="24"
                android:startX="32"
                android:startY="74"
                android:type="linear">
                <item android:color="#00FF87" android:offset="0.0" />
                <item android:color="#FFFFFF" android:offset="0.75" />
